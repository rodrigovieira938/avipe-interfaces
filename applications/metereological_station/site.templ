package metereological_station

import "fmt"

templ MainPage(d DadosEstacao) {
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.7/dist/htmx.js" integrity="sha384-yWakaGAFicqusuwOYEmoRjLNOC+6OFsdmwC2J711DeCZ" crossorigin="anonymous"></script>
    <main class="flex-1 flex-auto bg-slate-500 text-white min-h-screen overflow-x-hidden">
        <div class="text-white">
            <div class="flex"> 
                <h1 class="text-2xl py-7 px-4 md:px-10">Metereological App</h1>
            </div>

            <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-2 gap-y-4 grid-flow-row-dense px-4 md:px-8'>
                <div class='rounded-lg shadow-xl min-h-[100px] row-span-6 bg-cover bg-center flex flex-col justify-between'
                    style="background-image: url('./static/resources/uva3.jpeg'); ">
                    <div class="p-4 md:p-6 font-bold text-xl md:text-2xl">
                        { NomeEstacao(d.EstacaoID) }
                    </div>
                    if d.EstacaoID == 0 {
                        <div class="h-[100px] w-[100px] bg-no-repeat bg-center bg-contain ml-auto mr-2 mb-1"
                            style="background-image: url('./static/icons/right-arrow-icon.png') ;cursor: pointer;"
                            hx-get="/api/v1/MetereologicalStationApp/interface/1"
                            hx-on="click" hx-target="main" hx-swap="outerHTML"></div>
                    } else {
                        <div class="flex justify-between items-end p-2">
                            <div class="h-[80px] w-[80px] md:h-[100px] md:w-[100px] 
                                        bg-no-repeat bg-center bg-contain cursor-pointer"
                                style="background-image: url('./static/icons/left-arrow-icon.png');"
                                hx-get={fmt.Sprintf("/api/v1/MetereologicalStationApp/interface/%d", d.EstacaoID-1)}
                                hx-target="main"
                                hx-swap="outerHTML">
                            </div>

                            if d.EstacaoID < len(Dados)-1 {
                                <div class="h-[80px] w-[80px] md:h-[100px] md:w-[100px] 
                                            bg-no-repeat bg-center bg-contain cursor-pointer"
                                    style="background-image: url('./static/icons/right-arrow-icon.png');"
                                    hx-get={fmt.Sprintf("/api/v1/MetereologicalStationApp/interface/%d", d.EstacaoID+1)}
                                    hx-target="main"
                                    hx-swap="outerHTML">
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class='bg-slate-600 rounded-lg shadow-xl min-h-[100px] col-span-1 md:col-span-2 bg-cover bg-center'
                     style="background-image: url('./static/resources/montanhas.jpeg');">
                    <div class="text-center font-bold text-sm md:text-base">TEMPERATURAS</div>
                    <div class="flex justify-between items-center px-4">
                        <div class="font-bold text-2xl md:text-2xl">{ fmt.Sprintf("%.1f °C", d.Temperatura) }</div>
                        <div class="h-[80px] w-[80px] md:h-[100px] md:w-[100px] bg-no-repeat bg-center bg-contain"
                        style=" background-image: url('./static/icons/temperatura.png');"></div>
                    </div>
                </div>
                <div class='bg-slate-600 rounded-lg shadow-xl min-h-[110px] bg-cover bg-center'
                     style="background-image: url('./static/resources/chuva.jpeg');">
                     <div class="text-center font-bold text-sm md:text-base">PRECIPITAÇÃO</div>
                     <div class="flex justify-between items-center px-4">
                        <div class="font-bold text-2xl md:text-2xl">{ fmt.Sprintf("%.1f mm", d.Precipitacao) }</div>
                        <div class="h-[80px] w-[80px] md:h-[100px] md:w-[100px] bg-no-repeat bg-center bg-contain"
                        style=" background-image: url('./static/icons/chuva.png');"></div>
                     </div>
                </div>
                <div class='bg-slate-600 rounded-lg shadow-xl min-h-[110px] bg-cover bg-center'
                     style="background-image: url('./static/resources/folha_molhada.jpeg');">
                     <div class="text-center font-bold text-sm md:text-base">FOLHA MOLHADA</div>
                     <div class="flex justify-between items-center px-4">
                        <div class="font-bold text-2xl md:text-2xl">{ fmt.Sprintf("%.1f h", d.Folha) }</div>
                        <div class="h-[80px] w-[80px] md:h-[100px] md:w-[100px] bg-no-repeat bg-center bg-contain"
                        style=" background-image: url('./static/icons/folha.png');"></div>
                     </div>
                </div>
                <div class='bg-slate-600 rounded-lg shadow-xl min-h-[150px] row-span-3 bg-cover bg-center'
                     style="background-image: url('./static/resources/vento.jpeg');">
                     <div class="text-center font-bold text-sm md:text-base">VELOCIDADE DO VENTO</div>
                     <div class="flex justify-between items-center px-4">
                        <div class="font-bold text-2xl md:text-2xl">{ fmt.Sprintf("%.1f km/h", d.Vento) }</div>
                        <div class="h-[80px] w-[80px] md:h-[100px] md:w-[100px] bg-no-repeat bg-center bg-contain"
                        style=" background-image: url('./static/icons/vento.png');"></div>
                     </div>
                </div>
                <div class='bg-slate-600 rounded-lg shadow-xl min-h-[150px] row-span-3 bg-cover bg-center'
                     style="background-image: url('./static/resources/direcao_vento.jpeg');">
                     <div class="text-center font-bold text-sm md:text-base">DIREÇÃO DO VENTO</div>
                     <div class="flex justify-between items-center px-4">
                        <div class="font-bold text-2xl md:text-2xl">{ d.Direcao }</div>
                        <div class="h-[80px] w-[80px] md:h-[100px] md:w-[100px] bg-no-repeat bg-center bg-contain"
                        style=" background-image: url('./static/icons/direcao.png');"></div>
                     </div>
                </div>
                <div class='bg-slate-600 rounded-lg shadow-xl min-h-[100px] col-span-1 md:col-span-2 bg-cover bg-center'
                     style="background-image: url('./static/resources/precipitacao.jpeg');">
                     <div class="text-center font-bold text-sm md:text-base">HUMIDADE RELATIVA</div>
                     <div class="flex justify-between items-center px-4">
                        <div class="font-bold text-2xl md:text-2xl">{ fmt.Sprintf("%.1f %%", d.Humidade) }</div>
                        <div class="h-[80px] w-[80px] md:h-[100px] md:w-[100px] bg-no-repeat bg-center bg-contain"
                        style=" background-image: url('./static/icons/humidade.png');"></div>
                     </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-2 gap-y-4 grid-flow-row-dense px-4 md:px-8 pt-7">
                <div class="rounded-lg shadow-xl min-h-[250px] row-span-6 bg-cover bg-center flex items-center justify-start">
                    <div class="flex flex-col items-center justify-start space-y-4 bg-gray-800 p-4 rounded-lg ml-4 md:ml-15">
                        <div class="w-12 h-12 rounded-full bg-green-500"></div>
                        <div class="w-12 h-12 rounded-full bg-yellow-500"></div>
                        <div class="w-12 h-12 rounded-full bg-red-500"></div>
                    </div>
                </div>
                <div class="rounded-lg shadow-xl min-h-[250px] row-span-6 bg-cover bg-center flex items-center justify-start">
                    <div class="flex flex-col items-center justify-start space-y-4 bg-gray-800 p-4 rounded-lg ml-4 md:ml-15">
                        <div class="w-12 h-12 rounded-full bg-green-500"></div>
                        <div class="w-12 h-12 rounded-full bg-yellow-500"></div>
                        <div class="w-12 h-12 rounded-full bg-red-500"></div>
                    </div>
                </div>
            </div>
        </div>
    </main>
}